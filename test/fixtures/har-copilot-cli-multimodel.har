                        "text": "{\"name\":\"copilot-cli/extension.activate\",\"time\":\"2026-06-19T12:44:06.566Z\",\"iKey\":\"7d7048df-6dd0-4048-bb23-b716c1461f8f\",\"tags\":{\"ai.user.id\":\"\"},\"data\":{\"baseType\":\"EventData\",\"baseData\":{\"properties\":{\"common_os\":\"darwin\",\"common_platformversion\":\"25.5.0\",\"common_arch\":\"arm64\",\"common_cpu\":\"Apple M4 Max\",\"common_extname\":\"copilot-cli\",\"common_extversion\":\"1.0.64-0\",\"editor_version\":\"1.0.64-0\",\"copilot_trackingId\":\"\",\"sku\":\"\"},\"name\":\"copilot-cli/extension.activate\"}}}\n{\"name\":\"copilot-cli/cli.telemetry\",\"time\":\"2026-06-19T12:44:07.137Z\",\"iKey\":\"7d7048df-6dd0-4048-bb23-b716c1461f8f\",\"tags\":{\"ai.user.id\":\"b9ac692751c891009d8d37b690ea5ddb\"},\"data\":{\"baseType\":\"EventData\",\"baseData\":{\"properties\":{\"payload\":\"{\\\"kind\\\":\\\"exp_context_fetch\\\",\\\"properties\\\":{\\\"success\\\":\\\"true\\\",\\\"fetch_source\\\":\\\"auth_change\\\",\\\"fetch_outcome\\\":\\\"cache_hit\\\",\\\"assigned_experiments\\\":\\\"[\\\\\\\"cli_aa_t\\\\\\\",\\\\\\\"openai_toolsearch_enabled\\\\\\\",\\\\\\\"553h5936\\\\\\\",\\\\\\\"c_capicli_aa\\\\\\\",\\\\\\\"h7c07110\\\\\\\",\\\\\\\"e974i579\\\\\\\",\\\\\\\"h0649438\\\\\\\",\\\\\\\"916bj795\\\\\\\",\\\\\\\"i810g980\\\\\\\",\\\\\\\"ibdi6602\\\\\\\",\\\\\\\"cjf2j356\\\\\\\",\\\\\\\"7f4g8540\\\\\\\",\\\\\\\"122j5628\\\\\\\",\\\\\\\"40003418\\\\\\\",\\\\\\\"405c7929\\\\\\\",\\\\\\\"ci93f471\\\\\\\",\\\\\\\"7483-enabled\\\\\\\",\\\\\\\"cli_aa_monitor_c\\\\\\\",\\\\\\\"anthropic_tool_search_enabled\\\\\\\",\\\\\\\"cfdic-spawn\\\\\\\",\\\\\\\"h600b851\\\\\\\",\\\\\\\"1j417828\\\\\\\",\\\\\\\"9789-enabled\\\\\\\"]\\\",\\\"flights\\\":\\\"{\\\\\\\"9dd4c115-7dcb-c453-d2b5-339c74a1ded6\\\\\\\":\\\\\\\"cli_aa_t\\\\\\\",\\\\\\\"b9d1aa5b-9e31-2fdb-90af-f04b67cedbe0\\\\\\\":\\\\\\\"openai_toolsearch_enabled\\\\\\\",\\\\\\\"f81660f7-c021-d3ce-e95c-70ba7561213d\\\\\\\":\\\\\\\"553h5936\\\\\\\",\\\\\\\"3004ead9-9bf8-0e7e-77ed-3b