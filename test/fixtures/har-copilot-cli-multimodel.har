on_delta\"},\"index\":1,\"type\":\"content_block_delta\"}\n\nevent: content_block_delta\ndata: {\"delta\":{\"partial_json\":\", \\\"ma\",\"type\":\"input_json_delta\"},\"index\":1,\"type\":\"content_block_delta\"}\n\nevent: content_block_delta\ndata: {\"delta\":{\"partial_json\":\"x_length\\\":\",\"type\":\"input_json_delta\"},\"index\":1,\"type\":\"content_block_delta\"}\n\nevent: content_block_delta\ndata: {\"delta\":{\"partial_json\":\" 2000\",\"type\":\"input_json_delta\"},\"index\":1,\"type\":\"content_block_delta\"}\n\nevent: content_block_delta\ndata: {\"delta\":{\"partial_json\":\"0}\",\"type\":\"input_json_delta\"},\"index\":1,\"type\":\"content_block_delta\"}\n\nevent: content_block_stop\ndata: {\"index\":1,\"type\":\"content_block_stop\"}\n\nevent: message_delta\ndata: {\"copilot_usage\":{\"token_details\":[{\"batch_size\":1000000,\"cost_per_batch\":500000000000,\"token_count\":3,\"token_type\":\"input\"},{\"batch_size\":1000000,\"cost_per_batch\":50000000000,\"token_count\":14452,\"token_type\":\"cache_read\"},{\"batch_size\":1000000,\"cost_per_batch\":625000000000,\"token_count\":7373,\"token_type\":\"cache_write\"},{\"batch_size\":1000000,\"cost_per_batch\":2500000000000,\"token_count\":138,\"token_type\":\"output\"}],\"total_nano_aiu\":5677225000},\"delta\":{\"stop_details\":null,\"stop_reason\":\"tool_use\",\"stop_sequence\":null},\"type\":\"message_delta\",\"usage\":{\"cache_creation_input_tokens\":7373,\"cache_read_input_tokens\":14452,\"input_tokens\":3,\"output_tokens\":138}}\n\nevent: message_stop\ndata: {\"amazon-bedrock-invocationMetrics\":{\"cacheReadInputTokenCount\":14452,\"cacheWriteInputTokenCount\":7373,\"firstByteLatency\":1713,\"inputTokenCount\":3,\"invocationLatency\":2970,\"outputTokenCount\":138},\"type\":\"message_stop\"}\n\ndata: [DONE]\n\n"
