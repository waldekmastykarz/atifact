                        "mimeType": "application/json",
                        "text": "{\"model\":\"gpt-4o-mini\",\"messages\":[{\"role\":\"system\",\"content\":\"Generate a short title for a coding session based on the user's message.\\n\\nRules:\\n- 2-6 words, title case\\n- Focus on the task, not conversational aspects\\n- No quotes, no punctuation at start/end\\n- Output the title inside <session-title></session-title> tags\\n\\nExamples:\\n- User message about fixing a login bug \u2192 <session-title>Fix Login Form Bug</session-title>\\n- User message about adding dark mode \u2192 <session-title>Add React Dark Mode</session-title>\\n- User message about refactoring queries \u2192 <session-title>Refactor Database Queries</session-title>\"},{\"role\":\"user\",\"content\":\"Generate a session title for this message:\\n\\n<user_message>\\nGet SPFx v1.23.0 information from https://learn.microsoft.com/en-us/sharepoint/dev/spfx/release-1.23.0\\n</user_message>\"}],\"temperature\":0,\"top_p\":0.95,\"frequency_penalty\":0,\"presence_penalty\":0,\"snippy\":{\"enabled\":false}}",
